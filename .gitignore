# Secrets
*.secret
*.key
*.pem
*.crt
*.p12
.sops.yaml
age.key
*.age

# Cloudflare
cloudflared/
*.json
!configs/**/*.example.json
# Locally authored Grafana dashboards are version controlled — the blanket
# *.json rule above would otherwise silently drop them from the repo.
!ansible/roles/grafana/files/dashboards/*.json

# Ansible
ansible/vault/
*.vault.yml

# Local overrides
*.local.yml
*.local.conf
configs/*/production/
configs/*/secrets/

# Sanitization reference (local-only; must NOT be public)
SANITIZATION_RULES.md

# OS/Editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log
logs/

# Terraform (if used)
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
package-lock.json

# Build artifacts
dist/
build/
*.tar.gz
*.zip

# Handoff plan — real internal values, deliberately lives OUTSIDE the repo
proxmox-homelab-plan*.md
