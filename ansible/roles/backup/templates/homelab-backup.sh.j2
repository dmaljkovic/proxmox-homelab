#!/bin/bash
# ---------------------------------------------------------------------------
# Homelab service-level backups (managed by Ansible — do not edit on the host)
# Proxmox container images are backed up separately by the vzdump job; this
# script captures the application data inside the running containers.
# ---------------------------------------------------------------------------
set -euo pipefail

BACKUP_ROOT="{{ backup_root }}"
RETENTION="{{ backup_retention_days }}"
DATE="$(date +%F)"
LDAP_CT={{ hostvars['openldap'].vmid }}
GITEA_CT={{ hostvars['gitea'].vmid }}
PROM_CT={{ hostvars['prometheus'].vmid }}
PROM_URL="http://{{ hostvars['prometheus'].ansible_host }}:9090"

log() { echo "[$(date '+%F %T')] $*"; }

# Serialize runs
exec 9>/var/lock/homelab-backup.lock
flock -n 9 || { log "another backup is already running"; exit 0; }

mkdir -p "$BACKUP_ROOT"/{ldap,gitea,prometheus}
log "backup start"

# --- OpenLDAP (slapcat -> LDIF) --------------------------------------------
if pct status "$LDAP_CT" | grep -q running; then
  pct exec "$LDAP_CT" -- slapcat -n 0 > "$BACKUP_ROOT/ldap/config-$DATE.ldif"
  pct exec "$LDAP_CT" -- slapcat -n 1 > "$BACKUP_ROOT/ldap/data-$DATE.ldif"
  log "ldap: wrote data-$DATE.ldif ($(wc -l < "$BACKUP_ROOT/ldap/data-$DATE.ldif") lines)"
else
  log "ldap: CT $LDAP_CT not running, skipped"
fi

# --- Gitea (SQLite online backup) ------------------------------------------
if pct status "$GITEA_CT" | grep -q running; then
  pct exec "$GITEA_CT" -- sqlite3 /var/lib/gitea/data/gitea.db ".backup /tmp/gitea-$DATE.db"
  pct exec "$GITEA_CT" -- sqlite3 /tmp/gitea-$DATE.db "PRAGMA integrity_check;" | grep -qx ok
  pct pull "$GITEA_CT" /tmp/gitea-$DATE.db "$BACKUP_ROOT/gitea/gitea-$DATE.db"
  pct exec "$GITEA_CT" -- rm -f /tmp/gitea-$DATE.db
  log "gitea: wrote gitea-$DATE.db (integrity ok)"
else
  log "gitea: CT $GITEA_CT not running, skipped"
fi

# --- Prometheus (TSDB snapshot via admin API) ------------------------------
if pct status "$PROM_CT" | grep -q running; then
  SNAP="$(curl -fsS -XPOST "$PROM_URL/api/v1/admin/tsdb/snapshot" \
    | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')"
  if [ -n "$SNAP" ]; then
    pct exec "$PROM_CT" -- tar -czf - -C "/var/lib/prometheus/snapshots/$SNAP" . \
      > "$BACKUP_ROOT/prometheus/tsdb-$DATE.tar.gz"
    pct exec "$PROM_CT" -- rm -rf "/var/lib/prometheus/snapshots/$SNAP"
    log "prometheus: wrote tsdb-$DATE.tar.gz ($(du -h "$BACKUP_ROOT/prometheus/tsdb-$DATE.tar.gz" | cut -f1))"
  else
    log "prometheus: snapshot API returned no name"
  fi
else
  log "prometheus: CT $PROM_CT not running, skipped"
fi

# --- retention -------------------------------------------------------------
find "$BACKUP_ROOT/ldap"       -name '*.ldif'   -mtime +"$RETENTION" -delete
find "$BACKUP_ROOT/gitea"      -name '*.db'     -mtime +"$RETENTION" -delete
find "$BACKUP_ROOT/prometheus" -name '*.tar.gz' -mtime +"$RETENTION" -delete

log "backup done"
